{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Andy Assessment Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "program_url", "owner", "assets", "exclusions", "allowed_methods", "prohibited_methods", "rate_limit_rps", "valid_from", "expires_at", "human_approval"],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 8},
    "program_url": {"type": "string", "format": "uri"},
    "owner": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "allowed_methods": {"type": "array", "items": {"enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"]}},
    "prohibited_methods": {"type": "array", "items": {"type": "string"}},
    "rate_limit_rps": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "test_account_reference": {"type": ["string", "null"]},
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approver", "approved_at"],
      "properties": {
        "approved": {"const": true},
        "approver": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "authorization_evidence_reference": {"type": "string", "minLength": 1}
  }
}
